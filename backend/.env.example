FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/login
SOCIAL_REDIRECT_WHITELIST=http://localhost:5173/login

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/social/google/callback/

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/social/github/callback/

RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

GEMINI_API_KEY=your-gemini-api-key

# Email delivery for OTPs and password reset.
# If EMAIL_HOST is omitted, local development prints emails in the backend terminal.
# For Gmail, use an app password, not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=InternConnect <your-email@gmail.com>
ALLOWED_COLLEGE_EMAIL_DOMAINS=lpu.in
